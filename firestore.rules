rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these logins can change a menu. Use lowercase emails.
    // Replace the two example emails with your own and your client's.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          'you@example.com',
          'client@example.com'
        ];
    }

    // Anyone can read a menu. Only the logins above can edit it.
    match /restaurants/{rid} {
      allow read: if true;
      allow write: if isOwner();

      match /items/{itemId} {
        allow read: if true;
        allow write: if isOwner();
      }
    }
  }
}
